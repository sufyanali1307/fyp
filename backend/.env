# ──────────────────────────────────────────────────────────
#  NexusCode Backend Configuration
# ──────────────────────────────────────────────────────────

# ── Docker Host ──────────────────────────────────────────
#  Leave DOCKER_HOST empty to use the local Docker daemon.
#  For a remote Linux VPS, set:  ssh://root@YOUR_VPS_IP
#
DOCKER_HOST=

# ── Remote IP ────────────────────────────────────────────
#  Leave as localhost when Docker runs on same machine.
#
DOCKER_REMOTE_IP=localhost

# ── Flask ────────────────────────────────────────────────
FLASK_PORT=8000

